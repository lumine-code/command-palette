{
  // One block per selector rather than a comma list: calculateSpecificity
  // truncates at the first comma, so `.command-palette lumine-text-editor` was
  // scored as `body`'s 1 instead of the 11 it earns.
  "lumine-workspace": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle"
  },
  ".command-palette lumine-text-editor": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle"
  },
  // `[mini]` is load-bearing rather than decorative: core binds f11 to
  // select-list:restore-query on `.select-list lumine-text-editor[mini]`, which
  // scores 21, and the block above scores 11. Matching the 21 is what lets load
  // order decide, and a package always loads after core. The palette therefore
  // trades restore-query for this inside its own list, and nowhere else.
  ".command-palette lumine-text-editor[mini]": {
    "f11": "command-palette:toggle-descriptions"
  }
}
