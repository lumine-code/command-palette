{
  // One block per selector rather than a comma list: calculateSpecificity
  // truncates at the first comma, so `.command-palette lumine-text-editor` was
  // scored as `body`'s 1 instead of the 11 it earns.
  "lumine-workspace": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle"
  },
  // Keep Control-D/Control-H available for Cocoa deletion and Ctrl/Cmd-D for
  // selecting a word. These actions only hold their chords inside the picker.
  ".command-palette lumine-text-editor": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle",
    "cmdorctrl-k d": "command-palette:toggle-descriptions",
    "cmdorctrl-k shift-d": "command-palette:toggle-hidden-commands"
  }
}
