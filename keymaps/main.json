{
  // One block per selector rather than a comma list: calculateSpecificity
  // truncates at the first comma, so `.command-palette lumine-text-editor` was
  // scored as `body`'s 1 instead of the 11 it earns.
  "lumine-workspace": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle"
  },
  // `ctrl-d` and `ctrl-h` need no `[mini]` and no specificity of their own:
  // core binds both at `body` scope only — `core:delete` and `core:backspace`
  // on darwin, `native!` inside a native input — and a binding on the palette's
  // own editor is nearer the dispatch target than `body` is, which outranks
  // specificity outright. They leave f11 to select-list:restore-query, the way
  // it is in every other dialog, and they only hold the keys while the palette
  // is open.
  ".command-palette lumine-text-editor": {
    "cmdorctrl-shift-p": "command-palette:toggle",
    "f1": "command-palette:toggle",
    "ctrl-d": "command-palette:toggle-descriptions",
    "ctrl-h": "command-palette:toggle-hidden-commands"
  }
}
